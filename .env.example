INFERENCE_HOST=0.0.0.0
INFERENCE_PORT=8080
# Set to 0.0.0.0 when AI Stack/Jarvis runs on another VM; keep 127.0.0.1 for local-only access.
INFERENCE_BIND_ADDRESS=127.0.0.1
INFERENCE_API_KEY=
# Only set true for isolated local development. Production startup fails closed without a key.
INFERENCE_ALLOW_INSECURE_NO_AUTH=false

MODEL_REGISTRY=qwen3:1.7b,qwen3:4b
DEFAULT_MODEL=qwen3:1.7b

# Dedicated inference VM: single CPU generation and single loaded model.
MAX_CONCURRENT_REQUESTS=1
# Waiting requests only; the active inference slot is separate.
MAX_QUEUE_SIZE=8
MAX_LOADED_MODELS=1

# Gateway admission budget; Ollama has its own container budget below.
MEMORY_BUDGET_GB=10
MEMORY_HEADROOM_GB=1.0
MODEL_MEMORY_ESTIMATE_GB=0

BACKEND_HTTP_TIMEOUT_SECONDS=600
# Separate deadlines keep queueing, embeddings, and generation from starving each other.
QUEUE_TIMEOUT_SECONDS=90
EMBEDDING_TIMEOUT_SECONDS=30
CHAT_TIMEOUT_SECONDS=300
STREAM_TIMEOUT_SECONDS=300
SHUTDOWN_TIMEOUT_SECONDS=30
MODEL_REFRESH_SECONDS=15

CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_RECOVERY_SECONDS=15

OLLAMA_URL=http://ollama:11434
LLAMACPP_URL=
LLAMACPP_MANAGED=false
# Native managed mode: set executable, model GGUF path, alias, and a matching MODEL_REGISTRY.
LLAMACPP_SERVER=llama-server
LLAMACPP_MODEL=
LLAMACPP_ALIAS=
MODEL_DIRECTORY=~/models
LLAMACPP_HOST=127.0.0.1
LLAMACPP_PORT=8081
# Default to physical cores; set explicitly only to override.
# LLAMACPP_THREADS=
# LLAMACPP_BATCH_THREADS=
LLAMACPP_BATCH_SIZE=512
LLAMACPP_UBATCH_SIZE=128
LLAMACPP_PARALLEL=1
LLAMACPP_GPU_LAYERS=0
LLAMACPP_CACHE_PROMPT=true
LLAMACPP_CACHE_RAM_MIB=0
LLAMACPP_CACHE_REUSE=0
LLAMACPP_CACHE_TYPE_K=
LLAMACPP_CACHE_TYPE_V=
LLAMACPP_FLASH_ATTENTION=false
LLAMACPP_JINJA=true
LLAMACPP_METRICS=true
LLAMACPP_MLOCK=false
LLAMACPP_REASONING_FORMAT=
# Optional speculative-decoding draft GGUF path; enables --draft-model when supported.
LLAMACPP_DRAFT_MODEL=
LLAMACPP_DRAFT_MAX_LEN=5
LLAMACPP_DRAFT_MIN_LEN=5
LLAMACPP_EMBEDDINGS=false
LLAMACPP_LOG_FILE=logs/llama-server.log
LLAMACPP_LOG_MAX_MIB=50
LLAMACPP_RESTART_ENABLED=true
LLAMACPP_MAX_RESTARTS=5
LLAMACPP_RESTART_DELAY_SECONDS=3
LLAMACPP_STARTUP_TIMEOUT_SECONDS=300
OLLAMA_KEEP_ALIVE=30m
# Safety caps for a CPU-only VM; request overrides cannot exceed this context.
MAX_CONTEXT_LENGTH=8192
MAX_OUTPUT_TOKENS=2048
MAX_EMBEDDING_BATCH_SIZE=64

# Dedicated inference VM: 2 vCPU / 10 GiB total. Containers are capped at 1.9 CPU / 9 GiB to leave host headroom.
INFERENCE_CPUS=0.4
INFERENCE_MEMORY_LIMIT=1g
OLLAMA_CPUS=1.5
OLLAMA_MEMORY_LIMIT=8g
OLLAMA_MODELS=qwen3:1.7b,qwen3:4b,nomic-embed-text

# Watchdog thresholds.
MIN_FREE_DISK_GIB=10
MIN_AVAILABLE_RAM_GIB=1
