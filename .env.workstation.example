# Copy to .env for a native Linux workstation deployment.
INFERENCE_HOST=127.0.0.1
INFERENCE_PORT=8080
INFERENCE_API_KEY=replace-with-a-long-random-secret
INFERENCE_ALLOW_INSECURE_NO_AUTH=false

LLAMACPP_MANAGED=true
LLAMACPP_SERVER=/usr/local/bin/llama-server
LLAMACPP_HOST=127.0.0.1
LLAMACPP_PORT=8081
# Set this to the first shard for split GGUF models (for example model-00001-of-00004.gguf).
LLAMACPP_MODEL=~/models/Qwen3-Coder-Next-IQ3_M/Qwen_Qwen3-Coder-Next-IQ3_M.gguf
LLAMACPP_ALIAS=workstation-model
MODEL_DIRECTORY=~/models
MODEL_REGISTRY=workstation-model
DEFAULT_MODEL=workstation-model

MAX_CONTEXT_LENGTH=131072
MAX_OUTPUT_TOKENS=8192
MAX_CONCURRENT_REQUESTS=1
MAX_QUEUE_SIZE=4
MAX_LOADED_MODELS=1
MEMORY_BUDGET_GB=48
MEMORY_HEADROOM_GB=4
MODEL_MEMORY_ESTIMATE_GB=0

# Default to physical cores; keep these only as an explicit override.
LLAMACPP_THREADS=20
LLAMACPP_BATCH_THREADS=8
LLAMACPP_BATCH_SIZE=512
LLAMACPP_UBATCH_SIZE=128
LLAMACPP_PARALLEL=1
LLAMACPP_GPU_LAYERS=0
LLAMACPP_CACHE_PROMPT=true
LLAMACPP_CACHE_RAM_MIB=4096
LLAMACPP_FLASH_ATTENTION=true
LLAMACPP_JINJA=true
LLAMACPP_METRICS=true
# Optional: keeps weights resident (needs a memlock ulimit); avoid on constrained hosts.
LLAMACPP_MLOCK=false
LLAMACPP_REASONING_FORMAT=auto
# Optional speculative-decoding draft GGUF path (e.g. a small distilled model).
# Enables llama-server --draft-model when the installed build supports it.
LLAMACPP_DRAFT_MODEL=
LLAMACPP_DRAFT_MAX_LEN=5
LLAMACPP_DRAFT_MIN_LEN=5
LLAMACPP_EMBEDDINGS=false
# Quantized KV caches require flash attention; use f16 here if the build has no FA kernels.
LLAMACPP_CACHE_TYPE_K=q8_0
LLAMACPP_CACHE_TYPE_V=q8_0
# Optional: reuse shared prompt prefixes of at least N tokens between agent turns.
# LLAMACPP_CACHE_REUSE=256
LLAMACPP_LOG_FILE=logs/llama-server.log
LLAMACPP_MAX_RESTARTS=5
LLAMACPP_RESTART_DELAY_SECONDS=3

BACKEND_HTTP_TIMEOUT_SECONDS=600
CHAT_TIMEOUT_SECONDS=600
STREAM_TIMEOUT_SECONDS=600
SHUTDOWN_TIMEOUT_SECONDS=30
# Loading a 50+ GiB GGUF from disk can take several minutes.
LLAMACPP_STARTUP_TIMEOUT_SECONDS=300
